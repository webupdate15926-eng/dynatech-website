# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase administration key
SUPABASE_SECRET_KEY=

# Cloudinary media library
CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Contact form email delivery (Resend)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=DYNATECH Website <website@your-verified-domain.com>

# Canonical public URL used by server security and CMS operations
CMS_SITE_URL=https://dynatecheg.com

# Private owner control. Never expose these with a NEXT_PUBLIC_ prefix.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD_HASH=scrypt:replace_with_salt:replace_with_hash
SUPER_ADMIN_SESSION_SECRET=replace_with_at_least_32_random_characters
